      "id": "3f537089-deb6-4a35-8b9d-fb9b0dea5d61",
      "name": "Load session",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "position": [
        660,
        0
      ],
      "alwaysOutputData": true,
      "executeOnce": true
    },
    {
      "parameters": {
        "jsCode": "// Решение принимает человек; система только исполняет его. Повторный запуск безопасен: файл уже в wiki — move ничего не меняет.\nconst d = $('Config').first().json;\nconst s = $input.all().map((i) => i.json).find((r) => r && r.session_id);\nif (!s) throw new Error('Сессия не найдена: ' + d.session_id);\nif (s.status !== 'awaiting_review') throw new Error(`Сессия ${s.session_id} не ждёт утверждения (статус ${s.status})`);\nconst action = String(d.action || '').trim().toLowerCase();\nif (!['approve', 'return'].includes(action)) throw new Error('action должен быть approve или return');\nif (action === 'return' && !String(d.comment || '').trim()) throw new Error('Для return заполните comment: что уточнить у заказчика');\nconst docId = (String(s.brd_url || '').match(/\\/d\\/([^/?#]+)/) || [])[1] || '';\nif (action === 'approve' && !docId) throw new Error('Не найден ID документа в brd_url сессии');\nreturn [{ json: { action, comment: String(d.comment || '').trim(), doc_id: docId, session: s } }];"
      },
      "id": "528ae727-f31d-43f3-9c54-b6b280702d88",
      "name": "Plan decision",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "01dfb47e-af56-40e6-bf67-a391f1ea3e9b",
              "leftValue": "={{ $json.action === 'approve' }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "id": "f0ab6bc9-c4cd-4f46-b14b-51637119e5bc",
      "name": "Approve?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1100,
        0
      ]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ 'https://www.googleapis.com/drive/v3/files/' + $json.doc_id }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleDriveOAuth2Api",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "addParents",
              "value": "={{ $('Config').first().json.BRD_FOLDER_ID }}"
            },
            {
              "name": "removeParents",
              "value": "={{ $('Config').first().json.REVIEW_FOLDER_ID }}"
            },
            {
              "name": "supportsAllDrives",
              "value": "true"
            },
            {
              "name": "fields",
              "value": "id,webViewLink"
            }
          ]
        },
        "options": {
          "timeout": 60000
        }
      },
      "id": "bda36387-99eb-431f-bed6-814522d75a8d",
      "name": "Move to wiki folder",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
        -100
      ],
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "__CRED_GDRIVE__",
          "name": "Google Drive OAuth2"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const p = $('Plan decision').first().json;\nconst s = p.session;\nconst url = $json.webViewLink || s.brd_url;\nreturn [{ json: {\n  row: { session_id: s.session_id, status: 'completed', brd_url: url, last_activity_at: new Date().toISOString() },\n  notes: [\n    { audience: 'customer', chat_id: s.chat_id, kind: 'success', title: 'BRD утверждён',\n      text: `Документ «${s.brd_title}» проверен командой AIOps и опубликован:\\n${url}\\n\\nДальше — согласование архитектуры. Начать новую беседу — /new`, source: 'approve' },\n    { audience: 'team', kind: 'success', title: 'BRD утверждён (HITL)', text: `«${s.brd_title}» — перенесён в wiki, заказчику отправлена ссылка.\\n${url}`, source: 'approve' },\n  ] } }];"
      },
      "id": "01855cda-e00e-4448-bcab-179d499935db",
      "name": "Approved rows",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        -100
      ]
    },
    {
      "parameters": {
        "jsCode": "// Петля возврата: сессия снова открыта, заказчик отвечает на вопросы в той же беседе; следующий /done — вторая попытка генерации.\nconst p = $json;\nconst s = p.session;\nreturn [{ json: {\n  row: { session_id: s.session_id, status: 'active', last_activity_at: new Date().toISOString(), error: 'Возвращён проверяющим: ' + p.comment },\n  notes: [\n    { audience: 'customer', chat_id: s.chat_id, kind: 'warning', title: 'Нужны уточнения по BRD',\n      text: `Команда AIOps просит уточнить: ${p.comment}\\n\\nОтветьте, пожалуйста, в этой беседе, а когда закончите — отправьте /done, и я обновлю документ.`, source: 'approve' },\n    { audience: 'team', kind: 'info', title: 'BRD возвращён заказчику (HITL)', text: `«${s.brd_title}» — возвращён с вопросами: ${p.comment}`, source: 'approve' },\n  ] } }];"
      },
