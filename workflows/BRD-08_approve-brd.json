      "parameters": {
        "jsCode": "const j = $('Session row').first().json;\nconst src = $('Approved rows').isExecuted ? $('Approved rows').first().json : $('Returned rows').first().json;\nreturn src.notes.filter((n) => !(n.audience === 'customer' && String(n.chat_id).startsWith('eval-'))).map((n) => ({ json: n }));"
      },
