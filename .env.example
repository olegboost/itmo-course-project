# ---------------------------------------------------------------
# n8n (Settings → n8n API → Create an API key)
N8N_BASE_URL=https://<your-instance>.app.n8n.cloud
N8N_API_KEY=

# ---------------------------------------------------------------
# Google Drive / Sheets (ID — часть URL после /folders/ или /d/)
CFG_KB_FOLDER_ID=            # папка базы знаний (Docs/Sheets/DOCX/XLSX/PDF/TXT/MD)
CFG_BRD_FOLDER_ID=           # папка-«wiki» для готовых BRD
CFG_LOGS_SHEET_ID=           # таблица «BRD agent — logs»: листы errors, brd_registry
CFG_KB_LOG_SHEET_ID=         # таблица «KB sync log»: лист kb_sync_log

# ---------------------------------------------------------------
# Telegram (ID групп обычно вида -100xxxxxxxxxx)
CFG_TEAM_CHAT_ID=            # чат команды: новые BRD, дайджест, отчёт о синхронизации БЗ
CFG_SUPPORT_CHAT_ID=         # чат саппорта: алерты о сбоях

# ---------------------------------------------------------------
# Pinecone (индекс dimension=1536, metric=cosine)
CFG_PINECONE_INDEX_NAME=itmo-l8-1536
CFG_PINECONE_INDEX_HOST=https://<index>-<project>.svc.<region>.pinecone.io
CFG_PINECONE_NAMESPACE=kb-brd-agent

# ---------------------------------------------------------------
# cloud.ru Foundation Models (OpenAI-совместимый API)
CFG_EMBEDDING_URL=https://foundation-models.api.cloud.ru/v1/embeddings
CFG_EMBEDDING_MODEL=openai/text-embedding-3-small
CFG_STT_URL=https://foundation-models.api.cloud.ru/v1/audio/transcriptions
CFG_STT_MODEL=openai/whisper-large-v3

# ---------------------------------------------------------------
# LLM через OpenRouter (денежный потолок — лимит ключа OpenRouter, см. docs/control-layer.md)
CFG_LLM_MODEL=deepseek/deepseek-v4.1-flash
# Цена модели, USD за 1M токенов (openrouter.ai/models) — для оценки расхода сессии.
# При смене модели меняйте и цену: для cost-attack с anthropic/claude-opus-5.5 — 4 и 20.
CFG_LLM_PRICE_IN=0.30
CFG_LLM_PRICE_OUT=1.20

# ---------------------------------------------------------------
# Только для ручного импорта (нет Public API, например trial n8n Cloud):
# ID заранее созданных пустых воркфлоу (из URL .../workflow/<ID>)
WF_ERRORS_ID=                # BRD-00 Errors & Support Alerts
WF_NOTIFY_ID=                # BRD-02 Notify (Telegram)
WF_QUEUE_ID=                 # BRD-07 Manual Queue (limits)
WF_BRD_GENERATOR_ID=         # BRD-04 BRD Generator & Publisher

# ---------------------------------------------------------------
# Для ссылок на executions в алертах
CFG_N8N_BASE_URL=https://<your-instance>.app.n8n.cloud

# ---------------------------------------------------------------
# ID credentials в n8n (Overview → Credentials → открыть → ID в URL).
# Пустые значения — узлы останутся без credentials, их можно выбрать в UI.
CRED_TELEGRAM=               # Telegram API (токен бота)
CRED_GDRIVE=                 # Google Drive OAuth2 API
CRED_GSHEETS=                # Google Sheets OAuth2 API
CRED_OPENROUTER=             # OpenRouter (ключ с лимитом $5/неделя)
CRED_HTTP_OPENROUTER=        # Header Auth: Authorization = Bearer <тот же ключ OpenRouter> (дайджест: расход ключа)
CRED_OPENAI_CLOUDRU=         # OpenAI API: ключ cloud.ru, Base URL https://foundation-models.api.cloud.ru/v1
CRED_PINECONE=               # Pinecone API
CRED_HTTP_PINECONE=          # Header Auth: Api-Key = <ключ Pinecone>
CRED_HTTP_CLOUDRU=           # Header Auth: Authorization = Bearer <ключ cloud.ru>
